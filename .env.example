# ==============================================================================
# mpc-docker — Variables de entorno
# Copia este archivo como .env y edita los valores.
# ==============================================================================

# === Rutas a los repos (relativas a mpc-docker/) =============================
MPC_API_PATH=../mypetcare_api
MPC_VET_PATH=../mpc_frontend
MPC_ADMIN_PATH=../admin_mpc
MPC_CLIENTES_PATH=../mpc_clientes

# === API — Supabase (Producción) =============================================
SUPABASE_URL=https://yedotxfgqjzmoaxnfhqw.supabase.co
SUPABASE_SERVICE_KEY=tu_service_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
CORS_ORIGINS=http://localhost

# === Frontend Vet (mpc_frontend) =============================================
VET_API_URL=http://localhost/api
VET_SUPABASE_URL=https://yedotxfgqjzmoaxnfhqw.supabase.co
VET_SUPABASE_ANON_KEY=tu_anon_key_aqui

# === Frontend Admin (admin_mpc) ==============================================
ADMIN_API_URL=http://localhost/api
ADMIN_SUPABASE_URL=https://yedotxfgqjzmoaxnfhqw.supabase.co
ADMIN_SUPABASE_ANON_KEY=tu_anon_key_aqui

# === Frontend Clientes (mpc_clientes) ========================================
CLIENTES_API_URL=http://localhost/api
